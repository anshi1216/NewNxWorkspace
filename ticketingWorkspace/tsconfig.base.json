{
  "compileOnSave": false,
  "compilerOptions": {
    "rootDir": ".",
    "sourceMap": true,
    "declaration": false,
    "moduleResolution": "node",
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "importHelpers": true,
    "target": "es2015",
    "module": "esnext",
    "lib": ["es2020", "dom"],
    "skipLibCheck": true,
    "skipDefaultLibCheck": true,
    "baseUrl": ".",
    "paths": {
      "@ticketing-workspace/angularLib": ["libs/angularLib/src/index.ts"],
      "@ticketing-workspace/reactLib": ["libs/reactLib/src/index.ts"],
      "@ticketing-workspace/shared-utilities": [
        "libs/shared-utilities/src/index.ts"
      ]
    }
  },
  "exclude": ["node_modules", "tmp"]
}
